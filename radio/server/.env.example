# Copy to .env and set strong unique passwords. NEVER commit the real .env.
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
ICECAST_RELAY_PASSWORD=change-me-relay
ICECAST_HOSTNAME=radio.example.org

# Base URL of the deployed Prayer Dome site (for playlist/announcement sync).
PD_API_BASE=https://prayerdome.net
# Must match RADIO_ADMIN_TOKEN configured in Vercel (private, server-to-server).
PD_RADIO_TOKEN=
