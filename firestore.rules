rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Core Authorization Helpers
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          (exists(/databases/$(database)/documents/memberships/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.role == 'admin') ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           getUserData().role == 'admin')
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ==========================================
    // Collection-Specific Rules
    // ==========================================

    // Users and Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      // Only a trusted administrator may assign or change roles.
      allow create: if isAdmin() || (isOwner(userId) &&
        request.resource.data.get('role', 'member') == 'member');
      allow update: if isAdmin() || (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // Announcements & Hero Banners (Public Read, Admin Write)
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // News and Articles
    match /news/{id} {
      // Unfiltered list queries on the public News page must be able to read
      // the whole collection; unpublished entries are still visually gated by
      // the app, and only admins can write.
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live Streaming State and Chat
    match /liveStatus/{id} {
      allow read: if true;
      // Admin full write; viewers may only increment viewers/totalViews counters
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'totalViews']) &&
        request.resource.data.viewers is int && request.resource.data.viewers >= 0 &&
        request.resource.data.viewers >= resource.data.viewers - 1 &&
        request.resource.data.viewers <= resource.data.viewers + 1 &&
        request.resource.data.totalViews is int &&
        request.resource.data.totalViews >= resource.data.totalViews &&
        request.resource.data.totalViews <= resource.data.totalViews + 1
      );
    }
    match /liveChat/{id} {
      allow read: if true;
      // Signed-in members OR guests (with a name) may post chat messages
      allow create: if (isSignedIn() ||
                        (request.resource.data.name is string &&
                         request.resource.data.name.size() >= 2 &&
                         request.resource.data.message is string &&
                         request.resource.data.message.size() >= 1 &&
                         request.resource.data.message.size() <= 500)) &&
                       (request.resource.data.hidden != true);
      allow update, delete: if isAdmin();
    }
    match /liveRecordings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Scheduled lives (admin creates, public reads)
    match /scheduledLives/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Moderation: muted/blocked users (admin only)
    match /liveMutedUsers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /liveBlockedUsers/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Reports submitted by viewers
    match /liveReports/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.reason is string &&
                       request.resource.data.reason.size() > 0;
      allow update, delete: if isAdmin();
    }

    // WebRTC signaling (joins, offers, answers, ICE candidates, reactions,
    // chat mirror, events, viewer presence). Public read/write because
    // viewer identity is not required to watch, and the data is transient
    // (admin wipes stale signals on start; next broadcast overwrites).
    //
    // A signed-out viewer must also be able to clear its own presence and
    // per-viewer signaling documents when it leaves the page: without this a
    // guest's seat stayed in "watching now" for ever, and a stale offer was
    // replayed to the next broadcast. The docs created here are per-viewer and
    // already world-writable, so removing them grants nothing new.
    match /liveSignals/{liveId}/viewers/{viewerId}/{document=**} {
      allow read, create, update, delete: if true;
    }
    match /liveSignals/{liveId}/viewers/{viewerId} {
      allow read, create, update, delete: if true;
    }
    match /liveSignals/{liveId}/join/{viewerId} {
      allow read, create, update, delete: if true;
    }
    match /liveSignals/{liveId}/{document=**} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || request.auth != null;
    }

    // Prayer Wall (Strict Moderation Rules)
    match /prayers/{id} {
      allow read: if resource.data.status == 'approved' ||
                   (isSignedIn() && resource.data.userId == request.auth.uid) ||
                   isAdmin();
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending');
      allow update: if isAdmin() ||
                    (isSignedIn() && resource.data.userId == request.auth.uid &&
                     request.resource.data.status == 'pending');
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Testimonies (Approved only for public)
    match /testimonies/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    // Devotionals
    match /devotionals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Daily Bible Verse schedule (special verses for holidays, programmes,
    // fasting seasons and events). Document id is the date, e.g. 2026-04-03.
    // Every device — signed in or not — must be able to read the verse of the
    // day so the lock-screen notification can be raised offline/in background.
    match /verseSchedule/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AI-assisted video library (sermons, Bible stories, devotionals,
    // inspirational messages, promotional clips).
    match /aiVideos/{id} {
      allow read: if resource.data.published != false || isAdmin();
      allow write: if isAdmin();
    }

    // Community Stats
    match /communityStats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Device Tokens for Push Notifications
    // Members manage only their own token; administrators read the roster so
    // broadcasts can be delivered. Token lists never leak to other members.
    match /userTokens/{tokenId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Sermons
    match /sermons/{id} {
      allow read: if resource.data.published != false || isAdmin();
      allow write: if isAdmin();
    }

    // Memberships
    match /memberships/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isOwner(id) &&
        request.resource.data.get('role', 'member') == 'member' &&
        request.resource.data.get('status', 'pending') == 'pending');
      allow update: if isAdmin() || (isOwner(id) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']));
      allow delete: if isAdmin();
    }

    // Offerings / Deposits / Withdrawals
    match /offerings/{id} {
      // Giving records are financial data. A member may read only their own
      // rows; the finance team reads and reconciles everything.
      allow read: if isAdmin() || (isSignedIn() && resource.data.donorUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.donorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /deposits/{id} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /withdrawals/{id} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // A member may open an empty wallet and change only their privacy PIN.
      // Balances are written by the billing function after a verified payment,
      // never by the browser.
      allow create: if isOwner(userId) &&
        request.resource.data.userId == userId &&
        request.resource.data.balance == 0 &&
        request.resource.data.currency is string &&
        request.resource.data.currency.size() <= 8;
      allow update: if isAdmin() || (isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin']) &&
        (!('pin' in request.resource.data) ||
          (request.resource.data.pin is string &&
           request.resource.data.pin.size() <= 40)));
      allow delete: if isAdmin();
    }

    // Support plan catalogue and subscriptions
    // ---------------------------------------------------------------------
    // The catalogue is public so the support page can render real prices
    // without a privileged API. Payment requests, subscriptions and wallet
    // transactions are created and changed only by the `billing` callable;
    // Firestore Rules deny every client write to those three collections.
    match /supportPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.data.id == planId &&
        request.resource.data.price is number &&
        request.resource.data.price > 0 &&
        request.resource.data.currency == 'USD' &&
        request.resource.data.active is bool;
    }

    match /paymentRequests/{reference} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;   // server only
    }

    match /subscriptions/{id} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;   // server only
    }

    match /walletTransactions/{id} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;   // server only
    }

    match /billingAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;   // server only
    }

    match /billingIdempotency/{id} {
      allow read, write: if false;   // server only
    }

    // Support Claims
    match /supportClaims/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Contact Messages
    match /contactMessages/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // Gallery
    match /gallery/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAdmin() || (isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Events
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Facebook campaign settings and generated posts are administrator-only.
    match /socialCampaigns/{id} {
      allow read, write: if isAdmin();
    }
    match /facebookPosts/{id} {
      allow read, write: if isAdmin();
    }

    // Admin Logs
    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications
    // The in-app notification centre lists announcement documents; delivery
    // documents (which carry device-token arrays) stay administrator-only.
    // Token-free copies of broadcast announcements, readable by every member
    // and guest so the in-app bell can list them. Push records stay private.
    match /publicNotifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isAdmin() || !('tokens' in resource.data);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Test Notifications
    match /test_notifications/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Translations
    match /translations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Certificates (Academy completions — member reads own, admin reads all)
    match /certificates/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Weekly Prayer Challenge progress (per member)
    match /prayerChallenges/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ==========================================
    // Team Management
    // ==========================================
    // Two collections, on purpose:
    //
    //   teamMembers        published, public-safe profile data. Visitors can
    //                      read a document only when `published == true`.
    //   teamMemberContacts private email/phone for the same member id. Only
    //                      administrators can read or write it, so an address
    //                      cannot leak through a public roster query.
    //
    // Records are never hard-deleted by the app when someone is marked
    // inactive, deceased or former — those states only change `status`, and
    // `published` decides whether the profile is listed publicly.
    match /teamMembers/{id} {
      allow read: if resource.data.published == true || isAdmin();
      // Field validation belongs with authorization: a malformed write from a
      // compromised admin session must not be able to break the public page.
      allow create, update: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.status in ['active', 'inactive', 'deceased', 'former'] &&
        request.resource.data.published is bool &&
        request.resource.data.priority is number &&
        (!('title' in request.resource.data) ||
          (request.resource.data.title is string && request.resource.data.title.size() <= 100)) &&
        (!('role' in request.resource.data) ||
          (request.resource.data.role is string && request.resource.data.role.size() <= 60)) &&
        (!('department' in request.resource.data) ||
          (request.resource.data.department is string && request.resource.data.department.size() <= 80)) &&
        (!('description' in request.resource.data) ||
          (request.resource.data.description is string && request.resource.data.description.size() <= 600)) &&
        (!('responsibilities' in request.resource.data) ||
          (request.resource.data.responsibilities is string && request.resource.data.responsibilities.size() <= 600)) &&
        (!('image' in request.resource.data) ||
          (request.resource.data.image is string && request.resource.data.image.size() <= 500)) &&
        (!('publicEmail' in request.resource.data) ||
          (request.resource.data.publicEmail is string && request.resource.data.publicEmail.size() <= 160)) &&
        (!('memorialMessage' in request.resource.data) ||
          (request.resource.data.memorialMessage is string && request.resource.data.memorialMessage.size() <= 400)) &&
        (!('showInMemorial' in request.resource.data) ||
          request.resource.data.showInMemorial is bool);
      allow delete: if isAdmin();
    }

    // Private half of a team member record. Same document id as teamMembers.
    match /teamMemberContacts/{id} {
      allow read: if isAdmin();
      // Delete is separate: `request.resource` is null for a delete, so it must
      // never be part of the field-validation condition.
      allow delete: if isAdmin();
      allow create, update: if isAdmin() &&
        (!('email' in request.resource.data) ||
          (request.resource.data.email is string && request.resource.data.email.size() <= 160)) &&
        (!('phone' in request.resource.data) ||
          (request.resource.data.phone is string && request.resource.data.phone.size() <= 40));
    }

    // ==========================================
    // Downloadable Resources library
    // ==========================================
    match /resources/{id} {
      allow read: if isAdmin() || resource.data.published != false;
      allow create, update, delete: if isAdmin();
    }

    // Prayer-wall style status posts (expire after 24h)
    match /statuses/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Quiz progress and results (per member)
    match /userQuiz/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Final exam submissions (member submits, admin reviews)
    match /finalExamSubmissions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Community study/fellowship groups — members create and join
    match /customGroups/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (!('members' in request.resource.data) || request.auth.uid in request.resource.data.members);
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // Event RSVPs (per member, per event)
    match /userEvents/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Member care / support requests (member submits privately, admin manages)
    match /memberCareRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Bible reading progress (per member — private)
    match /bibleProgress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Worship song library
    match /worshipSongs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Private one-to-one chats — strictly between the participants
    match /privateChats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();
    }

    // Game leaderboard (public board, each member owns their row)
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // Financial reports contain sensitive figures — administrators only.
    match /financialReports/{id} {
      allow read, write: if isAdmin();
    }

    // Personal prayer reminder settings
    match /userReminders/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Per-category device and email switches. The Cloud Functions consult
    // this document before a push or a non-essential email, so a member who
    // muted "news" is not buzzed or emailed even though the story still
    // appears in their bell. Essential account and payment mail ignores these
    // switches and is always delivered.
    match /userNotificationPrefs/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Daily verse alert preferences. The scheduled Cloud Function reads these
    // (with server credentials) so a member still receives their verse when
    // the app is closed; the member owns the document.
    match /userVerseSettings/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ==========================================
    // Church locations (public directory, admin managed)
    // ==========================================
    match /churchLocations/{id} {
      // A visitor may read only branches that are open. Closed or planned
      // branches stay visible to administrators.
      allow read: if isAdmin() || resource.data.status == 'active';
      allow create, update: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() <= 80 &&
        request.resource.data.status in ['active', 'planned', 'closed'] &&
        request.resource.data.lat is number &&
        request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
        request.resource.data.lng is number &&
        request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
        (!('mapUrl' in request.resource.data) ||
          (request.resource.data.mapUrl is string && request.resource.data.mapUrl.size() <= 400));
      allow delete: if isAdmin();
    }

    // ==========================================
    // Daily challenges (public read when published)
    // ==========================================
    match /dailyChallenges/{id} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 140 &&
        request.resource.data.published is bool &&
        (!('date' in request.resource.data) ||
          (request.resource.data.date is string && request.resource.data.date.size() == 10)) &&
        (!('points' in request.resource.data) ||
          (request.resource.data.points is number &&
           request.resource.data.points >= 0 && request.resource.data.points <= 500));
      allow delete: if isAdmin();
    }

    // ==========================================
    // Official identity settings
    // ==========================================
    // The founder signature is printed on public certificates and membership
    // cards. Everyone may read that one document; every other setting stays
    // administrator-only, and only an administrator may replace the image.
    match /settings/founder {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // Transactional email + member notifications
    // ==========================================
    // The mail service is server-side only. A member may read their own bell
    // entries and mark them read; they can never create, delete or alter the
    // message text, and the delivery log (which carries recipient addresses)
    // stays administrator-only.
    match /emailSettings/{id} {
      allow read, write: if isAdmin();
    }
    match /emailTemplates/{id} {
      allow read, write: if isAdmin();
    }
    match /emailOutbox/{id} {
      allow read: if isAdmin();
      allow write: if false;   // created by Cloud Functions only
    }
    match /userNotifications/{id} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
        request.resource.data.read is bool;
      allow create, delete: if false;
    }

    // ==========================================
    // Membership card verification projection
    // ==========================================
    // Deliberately contains only what is printed on the card. Email, phone,
    // national ID and the member's signature are never copied here, so a
    // public scan cannot leak private contact information.
    match /membershipVerification/{id} {
      // Public checks go through the verifyMembership callable, never a direct
      // document read. The projection includes internal user ids, issuing
      // administrator and status flags, so only administrators may read it.
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.membershipId is string &&
        request.resource.data.membershipId.size() > 0 &&
        request.resource.data.membershipId.size() <= 40 &&
        request.resource.data.status in ['pending', 'approved', 'rejected', 'revoked', 'suspended', 'expired'] &&
        (!('displayName' in request.resource.data) ||
          (request.resource.data.displayName is string &&
           request.resource.data.displayName.size() <= 120)) &&
        (!('verificationRef' in request.resource.data) ||
          (request.resource.data.verificationRef is string &&
           request.resource.data.verificationRef.size() >= 12 &&
           request.resource.data.verificationRef.size() <= 80));
      allow delete: if isAdmin();
    }

    // QR tokens are resolved server-side only. This collection must never be
    // world-readable: the pointer carries the same private snapshot fields.
    match /membershipVerificationRefs/{reference} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Who issued, suspended, reissued or revoked a card, and when.
    match /membershipVerificationHistory/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ==========================================
    // Document Studio (official letters, memos, certificates)
    // ==========================================
    // Drafts, approvals, published documents and the signature audit trail are
    // ministry records. Nothing here is public: the console exports a document
    // to PDF/DOCX/PNG/JPG when it is ready to be shared.
    match /documents/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Membership card template (brand, signatory, authorized signature image).
    // Readable only by a signed-in member — the card they display uses it — and
    // writable only by an administrator, so a signature image cannot be replaced
    // by anyone else and cannot be lifted anonymously from the project.
    match /membershipCardSettings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Live prayer requests raised during a broadcast (public feed, signed-in authors)
    match /livePrayers/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
