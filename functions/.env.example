# Copy to functions/.env.<your-project-id> (ignored by Git).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_UPLOAD_PRESET=live_streams
# Store CLOUDINARY_API_SECRET in Firebase Secret Manager, NOT this file:
# firebase functions:secrets:set CLOUDINARY_API_SECRET --project <project-id>

# --- Brevo email (verification message + support-page updates list) ---
# The API key itself belongs in Secret Manager / Vercel env, never here:
#   firebase functions:secrets:set BREVO_API_KEY --project <project-id>
#   vercel env add BREVO_API_KEY production
# The sender must be a verified sender or domain in Brevo, not an invented address.
BREVO_SENDER_EMAIL=noreply@prayerdome.net
BREVO_SENDER_NAME=Prayer Dome
# Optional: numeric contact list id and double opt-in template id from Brevo.
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
PD_SITE_URL=https://prayerdome.net
