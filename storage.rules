rules_version = '2';

// Private payment and claim evidence.
// There is deliberately no public read: a receipt is opened through a
// short-lived signed URL minted by the `billing` callable after it checks the
// owner or administrator role.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        firestore.get(/databases/(default)/documents/memberships/$(request.auth.uid)).data.role == 'admin' ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /billingEvidence/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
      allow update, delete: if false;
    }

    // Giving receipts use the same private, owner-or-finance rule. A giver
    // uploads once; the file is never publicly listable and cannot be swapped
    // or deleted afterwards.
    match /givingEvidence/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*|application/pdf');
      allow update, delete: if false;
    }

    // Prayer Dome Radio audio. Administrators upload gospel tracks, recorded
    // human presenter introductions and fallback audio; the listener needs a
    // public read URL, but no browser can write or replace a broadcast file.
    // Only audio content types are accepted, and the size cap keeps a single
    // upload from exhausting the Firebase Storage allowance.
    match /radioAudio/{kind}/{fileName} {
      allow read: if true;
      allow delete: if isAdmin() && kind in ['tracks', 'voices', 'announcements', 'fallback'];
      allow create, update: if isAdmin() &&
        kind in ['tracks', 'voices', 'announcements', 'fallback'] &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
