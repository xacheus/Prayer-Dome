# Upload only files required to build or run the Vercel deployment.
# The build writes the public website to dist/, so repository documentation,
# mobile sources, tests, Firebase configuration, and tooling are never served.
/*
!api/
!assets/
!documents/
!functions/
!lib/
!scripts/
!.well-known/
!*.html
!ai-prayer-data.js
!devotional-data.js
!firebase-messaging-sw.js
!live-stream-config.js
!sermons-data.js
!sw.js
!translation-data.js
!Prayer-Dome-User-Guide.pdf
!manifest.json
!robots.txt
!sitemap.xml
!package.json
!package-lock.json
!vercel.json

# api/share.js reuses this dependency-free handler. The rest of the Firebase
# Functions package is not needed by Vercel.
functions/*
!functions/billing.js
!functions/billing-catalog.js
!functions/share.js
!functions/brevo.js
!functions/translate.js
!functions/email-design.js
!functions/r2.js

# The Vercel billing gateway lives outside api/ so it does not consume a
# serverless-function slot; api/system.js imports it for /api/billing.
lib/*
!lib/billing-server.js

# Only the public-bundle builder is needed during the Vercel build. The
# explicit `npm ci --ignore-scripts` install command installs firebase-admin
# for the billing API without running this legacy functions postinstall hook.
scripts/*
!scripts/build-vercel.mjs
!scripts/install-functions.mjs
